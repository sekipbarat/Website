<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sekip Barat - SDC Solo Utara</title>
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-body: #fafafa;
            --bg-card: #ffffff;
            --border-color: #e4e4e7;
            --border-hover: #a1a1aa;
            --text-title: #09090b;
            --text-body: #3f3f46;
            --text-muted: #71717a;
            --badge-bg: #f4f4f5;
            --accent-black: #18181b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-body);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            padding: 16px;
            -webkit-font-smoothing: antialiased;
        }

        header {
            margin-bottom: 16px;
            text-align: center;
            width: 100%;
            max-width: 680px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .header-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            width: 100%;
        }

        .title-box {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            padding: 8px 16px;
            border-radius: 10px;
            cursor: pointer;
            transition: border-color 0.2s;
        }

        .title-box:hover {
            border-color: var(--border-hover);
        }

        h1 {
            font-size: 0.95rem;
            font-weight: 700;
            color: var(--text-title);
            letter-spacing: -0.01em;
        }

        /* Menu Hamburger Minimalis */
        .menu-container {
            position: relative;
        }

        .menu-icon-btn {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            width: 36px;
            height: 36px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
            color: var(--text-body);
            cursor: pointer;
            transition: all 0.2s;
        }

        .menu-icon-btn:hover {
            background: var(--accent-black);
            color: #ffffff;
            border-color: var(--accent-black);
        }

        .dropdown-menu {
            display: none;
            position: absolute;
            right: 0;
            top: 44px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
            padding: 4px;
            flex-direction: column;
            gap: 2px;
            z-index: 100;
            min-width: 150px;
        }

        .dropdown-menu.show {
            display: flex;
        }

        .dropdown-menu .nav-btn {
            width: 100%;
            text-align: left;
            border: none;
            background: transparent;
            padding: 8px 12px;
            border-radius: 6px;
            font-family: inherit;
            font-size: 0.825rem;
            font-weight: 500;
            color: var(--text-body);
            cursor: pointer;
        }

        .dropdown-menu .nav-btn:hover {
            background: var(--badge-bg);
            color: var(--text-title);
        }

        /* Teks Berjalan Running Text */
        .marquee-container {
            width: 100%;
            overflow: hidden;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 6px 0;
            white-space: nowrap;
        }

        .marquee-track {
            display: inline-block;
            white-space: nowrap;
            animation: scrollText 20s linear infinite;
            font-size: 0.75rem;
            font-weight: 500;
            color: var(--text-muted);
        }

        .marquee-track span {
            display: inline-block;
            padding: 0 10px;
        }

        .marquee-track .dot {
            color: var(--border-hover);
            padding: 0;
        }

        @keyframes scrollText {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }

        /* Container Utama */
        .main-wrapper {
            width: 100%;
            max-width: 680px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 14px;
            padding: 20px;
            box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
        }

        .section-content {
            display: none;
        }

        .section-content.active {
            display: block;
        }

        /* Header Subuh */
        .sdc-header {
            text-align: center;
            margin-bottom: 22px;
        }

        .sdc-header h3 {
            font-size: 1.05rem;
            color: var(--text-title);
            font-weight: 700;
            margin-bottom: 4px;
            letter-spacing: -0.01em;
        }

        .sdc-header p {
            font-size: 0.825rem;
            color: var(--text-muted);
            font-weight: 400;
            line-height: 1.45;
            max-width: 520px;
            margin: 0 auto;
        }

        /* Box Pengumuman Soft Minimalis */
        .announcement-box {
            display: none;
            background: #fefce8;
            border: 1px solid #fef08a;
            border-radius: 8px;
            padding: 8px 12px;
            margin-bottom: 18px;
            overflow: hidden;
        }

        .announcement-box.active {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .announcement-header {
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .announcement-marquee-wrapper {
            flex: 1;
            overflow: hidden;
            white-space: nowrap;
        }

        .announcement-text {
            display: inline-block;
            white-space: nowrap;
            font-size: 0.8rem;
            color: #854d0e;
            font-weight: 600;
            padding-left: 100%;
            animation: marqueeAnnounce 22s linear infinite;
        }

        @keyframes marqueeAnnounce {
            0% { transform: translateX(0); }
            100% { transform: translateX(-100%); }
        }

        /* Player Box */
        .audio-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .audio-card {
            position: relative;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 16px 18px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            transition: border-color 0.2s;
        }

        .audio-card:hover {
            border-color: var(--border-hover);
        }

        .date-info {
            position: absolute;
            top: 14px;
            right: 16px;
            font-size: 0.775rem;
            color: var(--text-muted);
            font-weight: 500;
            background: var(--badge-bg);
            border: 1px solid var(--border-color);
            padding: 3px 9px;
            border-radius: 6px;
            line-height: 1.2;
        }

        .card-top {
            padding-right: 110px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .row-1 {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 8px 10px;
        }

        .teacher-name {
            font-size: 0.825rem;
            font-weight: 600;
            color: var(--text-title);
            background-color: var(--badge-bg);
            border: 1px solid var(--border-color);
            padding: 3px 10px;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
        }

        .kitab-name {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-title);
            letter-spacing: -0.01em;
        }

        .row-2 {
            display: flex;
            align-items: center;
        }

        .page-info {
            font-size: 0.8rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .native-audio-player {
            width: 100%;
            height: 42px;
            border-radius: 8px;
            outline: none;
        }

        .audio-notice-box {
            background-color: #f4f4f5;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 12px 14px;
            margin: 4px 0;
        }

        .audio-notice-box .notice-desc {
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.45;
            font-weight: 400;
        }

        .previous-title-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 14px 0 4px 0;
        }

        .previous-title-container h4 {
            font-size: 0.775rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            white-space: nowrap;
        }

        .previous-title-container .title-line {
            flex: 1;
            height: 1px;
            background-color: var(--border-color);
        }

        /* --- DESAIN ANIMASI & TEKS LOADING RAPI --- */
        .loading-box {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 42px 16px;
            gap: 8px;
            text-align: center;
        }

        .loader-wave {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            height: 24px;
            margin-bottom: 6px;
        }

        .loader-wave div {
            width: 10px;
            height: 10px;
            background-color: var(--accent-black);
            border-radius: 50%;
            animation: wavePulse 1.2s infinite ease-in-out both;
        }

        .loader-wave div:nth-child(1) { animation-delay: -0.32s; }
        .loader-wave div:nth-child(2) { animation-delay: -0.16s; }
        .loader-wave div:nth-child(3) { animation-delay: 0s; }

        @keyframes wavePulse {
            0%, 80%, 100% {
                transform: scale(0.4);
                opacity: 0.25;
            }
            40% {
                transform: scale(1.1);
                opacity: 1;
            }
        }

        .loading-title {
            color: var(--text-title);
            font-size: 0.9rem;
            font-weight: 600;
            letter-spacing: -0.01em;
        }

        .loading-subtext {
            color: var(--text-muted);
            font-size: 0.775rem;
            font-weight: 400;
            line-height: 1.4;
        }

        .docs-wrapper {
            padding: 4px;
        }

        .docs-wrapper h3.section-title {
            font-size: 1.05rem;
            color: var(--text-title);
            margin-bottom: 16px;
            font-weight: 700;
            text-align: center;
        }

        .docs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
            gap: 14px;
        }

        .doc-card {
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            overflow: hidden;
            text-decoration: none;
            transition: border-color 0.2s;
            display: flex;
            flex-direction: column;
        }

        .doc-card:hover {
            border-color: var(--border-hover);
        }

        .doc-card img {
            width: 100%;
            height: 140px;
            object-fit: cover;
            display: block;
        }

        .doc-card-info {
            padding: 12px;
            text-align: center;
        }

        .doc-card-info h4 {
            font-size: 0.85rem;
            color: var(--text-title);
            font-weight: 600;
            margin-bottom: 3px;
        }

        .doc-card-info span {
            font-size: 0.775rem;
            color: var(--text-muted);
            font-weight: 500;
        }

        .about-wrapper {
            padding: 10px 4px;
            text-align: center;
            color: var(--text-body);
            line-height: 1.55;
            max-width: 520px;
            margin: 0 auto;
        }

        .about-wrapper h3 {
            font-size: 1.05rem;
            color: var(--text-title);
            margin-bottom: 10px;
            font-weight: 700;
        }

        .about-wrapper p {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 10px;
        }

        .about-wrapper .closing {
            font-weight: 600;
            color: var(--text-title);
            margin-top: 14px;
        }

        footer {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 20px;
            text-align: center;
            font-weight: 400;
        }
    </style>
</head>
<body>

