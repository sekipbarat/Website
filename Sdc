                const data = await response.json();
                
                let textPengumuman = "";
                if (Array.isArray(data)) {
                    const itemWithAnnounce = data.find(item => item.pengumuman && item.pengumuman.toString().trim() !== "");
                    if (itemWithAnnounce) {
                        textPengumuman = itemWithAnnounc
