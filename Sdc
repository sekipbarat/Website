                <p class="closing">Alhamdulillah jazza Kummullohu Khoiro</p>
            </div>
        </div>
    </div>

    <footer>
        Sekip Barat &copy; 2026
    </footer>

    <script>
        const GOOGLE_SHEET_URL = "https://script.google.com/macros/s/AKfycbz8J48kbjFFXuS_6zKVaxPO2ABz23WntlAAb3jSzAORtuNJXQb30nTUYXBHy0vuuEHt/exec";

        function formatTanggal(str) {
            if (!str) return '';
            const val = str.toString().trim();
            if (val.includes('T') && val.includes('Z')) {
                const d = new Date(val);
                if (!isNaN(d.getTime())) {
                    return d.toLocaleDateString('id-ID', {
                        weekday: 'short',
                        day: 'numeric',
                        month: 'short'
                    });
                }
            }
            return val;
        }

        function formatHalaman(str) {
            if (!str) return '';
            const val = str.toString().trim();
            if (val.includes('T') && val.includes('Z')) {
                const d = new Date(val);
                if (!isNaN(d.getTime())) {
                    return `${d.getDate()}–${d.getMonth() + 1}`;
                }
            }
            return val;
        }

